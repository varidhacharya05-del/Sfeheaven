# SafeHaven Backend · Environment Variables
# Copy to .env and fill in strong random values before production deploy

PORT=3000

# JWT signing secrets — use long random strings in production
# e.g. openssl rand -base64 48
JWT_SECRET=safehaven-jwt-secret-change-in-production
PRE_JWT_SECRET=safehaven-pre-jwt-change-in-production
LOC_JWT_SECRET=safehaven-loc-jwt-change-in-production
